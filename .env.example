# ---------------------------------------------------------------------------
# Site configuration (src/lib/site/config.ts). DECISIONS.md D-005.
# A build with SITE_ENV=production FAILS unless SITE_NAME, SITE_URL,
# CONTACT_EMAIL and LEGAL_ENTITY are set. Never commit real values to .env.example.
# ---------------------------------------------------------------------------

# production | staging. Unset: `next dev` = development (drafts shown, noindex),
# `next build` = preview (drafts excluded, everything noindex).
SITE_ENV=

# {{SITE_NAME}}: working name until the owner decides.
SITE_NAME=
# {{DOMAIN}} as an https origin with no trailing slash, for example https://example.com
SITE_URL=
# {{CONTACT_EMAIL}}
CONTACT_EMAIL=
# {{LEGAL_ENTITY}}: the operator named on legal pages.
LEGAL_ENTITY=
# {{EMAIL_PROVIDER}}: used by the email adapter (Phase 6).
EMAIL_PROVIDER=

# Staging HTTP Basic auth (src/proxy.ts). Staging fails closed (503) if unset.
STAGING_USER=
STAGING_PASSWORD=

# Optional: point the content loader at another folder (tests and previews only).
# CONTENT_ROOT=

# ---------------------------------------------------------------------------
# NOT USED. Listed in the original PLAN.md for cloud sync, AI, payments and
# monitoring. Deferred (DECISIONS.md D-011): any service that could receive
# health data needs legal review (UK GDPR special category data, US health-data
# laws) before it is added.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# GEMINI_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# RESEND_API_KEY=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# NEXT_PUBLIC_ANALYTICS_DOMAIN=
