# ===========================================================================
# MenoVerdict environment variables. Copy to .env.local (or the host's
# environment settings) and fill in. Never commit real values.
# Every variable the code reads is listed here.
# ===========================================================================

# --- Site -------------------------------------------------------------------

# production | staging | preview | development.
# Unset: `next build` is production (indexable), `next dev` is development.
# Vercel preview deployments (VERCEL_ENV=preview) are automatically noindex.
SITE_ENV=production

# Canonical origin for every absolute URL (canonicals, sitemap, robots, RSS,
# Open Graph, structured data). https, no trailing slash.
SITE_URL=https://menoverdict.com

SITE_NAME=MenoVerdict
# Optional. Default: "Menopause answers, graded by evidence."
SITE_TAGLINE=
# Shown on the Contact page and in Organization structured data.
CONTACT_EMAIL=
# The operator named on legal pages.
LEGAL_ENTITY=

# --- Staging (src/proxy.ts) --------------------------------------------------
# Only when SITE_ENV=staging: HTTP Basic auth. Staging fails closed (503) if unset.
STAGING_USER=
STAGING_PASSWORD=

# --- Feature flags -----------------------------------------------------------
# Accounts and server sync. Keep false in production: the only backend is an
# in-memory mock with no real sign-in (see src/lib/account/guard.ts).
FEATURE_LOGIN=false
# Shows the AI assistant in navigation and pages. Without an API key it shows
# a "not available yet" message.
FEATURE_AI_PROMOTION=false
# App download / install promotion. Keep false.
FEATURE_APP_DOWNLOAD_PROMOTION=false

# --- Services (all optional; the site runs without them) ----------------------
# AI assistant (src/app/api/ai/chat/route.ts). Either name works.
GEMINI_API_KEY=
AI_API_KEY=
# Email signup (src/app/api/newsletter/subscribe/route.ts). Without a key,
# signup fails gracefully. Tracker or symptom data is never sent.
EMAIL_PROVIDER=
RESEND_API_KEY=

# --- Scheduled data deletion ---------------------------------------------------
# Secret for /api/cron/data-deletion. Required in production (fails closed).
CRON_SECRET=

# --- Development and tests only ------------------------------------------------
# Point the content loader at another folder (tests and previews).
# CONTENT_ROOT=
# Override the "today" date used by validators.
# VALIDATE_TODAY=
# Build id used to version the service worker (defaults to build time).
# BUILD_VERSION=

# --- Not used ----------------------------------------------------------------
# Supabase, Stripe, Sentry and analytics are not wired in. Any service that
# could receive health data needs legal review (UK GDPR special category data,
# US health-data laws) before it is added (DECISIONS.md D-011).
