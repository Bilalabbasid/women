{
  "name": "menoverdict",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:links": "tsx scripts/link-audit.ts",
    "validate:graph": "tsx scripts/validate-graph.ts",
    "validate:cta": "tsx scripts/validate-cta.ts",
    "validate:privacy": "tsx scripts/validate-privacy.ts",
    "validate:seo": "tsx scripts/validate-seo.ts",
    "validate:a11y": "tsx scripts/validate-a11y.ts",
    "validate:source": "npm run validate:content && npm run validate:plan && npm run validate:links && npm run validate:graph && npm run validate:cta",
    "validate:build": "npm run validate:seo && npm run validate:a11y && npm run validate:privacy && npm run validate:honesty && npm run validate:free",
    "validate": "npm run validate:source && npm run build && npm run validate:build",
    "prebuild": "tsx scripts/validate-content.ts",
    "content:approve": "tsx scripts/approve-page.ts",
    "validate:plan": "tsx scripts/validate-plan.ts",
    "plan:import": "tsx scripts/keyword-import.ts",
    "tool:approve": "tsx scripts/approve-tool.ts",
    "validate:honesty": "tsx scripts/validate-honesty.ts",
    "validate:free": "tsx scripts/validate-free.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "hast-util-to-string": "^3.0.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.50.0",
    "next": "^16.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
