{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.menoverdict.com"
        }
      ],
      "destination": "https://menoverdict.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/data-deletion",
      "schedule": "0 0 * * *"
    }
  ]
}
